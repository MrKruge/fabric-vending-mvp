# ── Personal Tenant (single environment, own capacity) ────────────────────────
# Use this when you want to spin up a Fabric capacity + workspaces in your own tenant.
# Copy to parameters/environments/personal.tfvars and fill in your values.

tenant_id                    = "00000000-0000-0000-0000-000000000000"  # Your Azure AD tenant ID
workspace_environment_suffix = "DEV"
create_domains               = true

# ── Capacity: create a new one ────────────────────────────────────────────────
create_capacity              = true
capacity_name                = "fabric-personal"
capacity_sku                 = "F2"                                     # Smallest paid SKU
capacity_resource_group      = "rg-fabric-personal"
capacity_location            = "West Europe"
capacity_admin_email         = "you@yourdomain.com"
capacity_subscription_id     = "00000000-0000-0000-0000-000000000000"  # Subscription for the capacity RG

# fabric_capacity_id is not needed when create_capacity = true

# Optional: SPN to grant Admin on all workspaces (e.g. a CI/CD pipeline identity)
# deployment_spn_object_id = "00000000-0000-0000-0000-000000000000"

# Optional: existing AAD group to nest into each workspace Admin group
# owner_group_display_name = "Fabric Admins"

# Optional: Fabric configured Git connection ID
# git_connection_id = "00000000-0000-0000-0000-000000000000"

# Sensitive: pass as TF_VAR_* env vars — never commit these
# fabric_spn_client_id     = "..."
# fabric_spn_client_secret = "..."
