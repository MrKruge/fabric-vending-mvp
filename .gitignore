# Terraform state and credentials
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable files with actual values (keep *.example files)
*.tfvars
!*.tfvars.example
# The pipeline reads config from parameters/ (IDs only, never secrets), so it is committed.
!parameters/**/*.tfvars

# Environment-specific secrets
.env
*.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Generated by scripts/bootstrap-backend.ps1
backend.generated.tf
